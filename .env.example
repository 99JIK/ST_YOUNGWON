# ============================================
# ST영원 스마트 오피스 환경 설정
# 이 파일을 .env로 복사 후 값을 수정하세요
# cp .env.example .env
# ============================================

# === LLM Provider ===
# openai  : OpenAI API (GPT-4o 등, API 키 필요)
# claude  : Anthropic API (Claude, API 키 필요)
# gemini  : Google Gemini API (API 키 필요)
# ollama  : 로컬/원격 Ollama 서버 (무료, 자체 GPU 필요)
LLM_PROVIDER=ollama

# === API Keys (사용하는 provider만 입력) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === LLM 모델 설정 ===
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-2.0-flash

# === Ollama 설정 (LLM_PROVIDER=ollama 일 때) ===
# 같은 PC: http://localhost:11434
# 외부 PC: http://<PC_IP>:11434 (OLLAMA_HOST=0.0.0.0 설정 필요)
# Docker 내부: http://ollama:11434 (docker-compose 사용 시 자동)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# === LLM 파라미터 ===
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# === Embedding ===
# openai : text-embedding-3-small (유료, 고품질)
# ollama : 로컬 임베딩 (무료, Ollama 필요)
EMBEDDING_PROVIDER=ollama
# OpenAI 임베딩 모델 (EMBEDDING_PROVIDER=openai 일 때)
EMBEDDING_MODEL=text-embedding-3-small
# Ollama 임베딩 모델 (EMBEDDING_PROVIDER=ollama 일 때)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# === RAG 설정 ===
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# === 업로드 ===
MAX_UPLOAD_SIZE_MB=200

# === Synology NAS ===
# NAS 주소 (예: http://192.168.1.100:5000)
SYNOLOGY_URL=
# NAS 서비스 계정 (파일 인덱스 백그라운드 스캔용, FileStation 접근 권한 필요)
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
# HTTPS 자체 서명 인증서 사용 시 false
SYNOLOGY_VERIFY_SSL=false

# === 보안 (반드시 변경하세요!) ===
SECRET_KEY=change-this-secret-key-in-production

# === Docker 설정 (docker-compose 전용) ===
# APP_PORT=8080

# === 로깅 ===
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
